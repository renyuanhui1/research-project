Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
      Splitter Ratio: 0.5
    Tree Height: 540
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Local Grid 10m
      Enabled: true
      Alpha: 0.20
      Cell Size: 10
      Plane Cell Count: 200
      Color: 120; 130; 145
      Line Style:
        Value: Lines
        Line Width: 0.03
      Reference Frame: <Fixed Frame>
      Plane: XY
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
    - Class: rviz_default_plugins/MarkerArray
      Name: Voxel Map
      Enabled: true
      Namespaces: {}
      Topic:
        Value: /voxel_map/markers
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/MarkerArray
      Name: Recorded Motion and Approximate Frusta
      Enabled: true
      Namespaces: {}
      Topic:
        Value: /voxel_map/trajectory
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Image
      Name: Recorded Cameras
      Enabled: true
      Normalize Range: true
      Min Value: 0
      Max Value: 1
      Median window: 5
      Topic:
        Value: /voxel_map/onboard
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
  Enabled: true
  Global Options:
    Background Color: 27; 32; 41
    Fixed Frame: world
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 135
      Focal Point:
        X: -10
        Y: -36
        Z: 20
      Name: Local flight preview
      Pitch: 0.48
      Target Frame: <Fixed Frame>
      Yaw: 0.70
    Saved: ~
Window Geometry:
  Width: 1500
  Height: 940
  X: 40
  Y: 40
  Displays:
    collapsed: false
  Recorded Cameras:
    collapsed: false
