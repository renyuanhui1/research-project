{
  // Project AirSim 机器人配置 schema，用来校验这个 JSONC 文件里的字段是否合法。
  "$schema":"../../ProjectAirSim/client/python/projectairsim/src/projectairsim/schema/robot_config_schema.jsonc",

  // 使用快速物理模型，适合四旋翼这类轻量仿真。
  "physics-type": "fast-physics",

  // links 定义无人机的刚体/视觉部件：主机体 Frame 和四个桨叶。
  // 这里的尺寸和坐标单位通常是米，不是 UE 里的厘米。
  "links": [
    {
      // 主机体，后面的电机、相机、IMU、GPS 等基本都挂在这个 Frame 上。
      "name": "Frame",
      "inertial": {
        // 主机体质量，单位 kg。
        "mass": 1.0,
        // 用一个 box 近似主机体的惯性。
        "inertia": {
          "type": "geometry",
          "geometry": {
            "box": {
              // 主机体近似尺寸：x/y/z 三个方向，单位 m。
              "size": "0.180 0.110 0.040"
            }
          }
        },
        // 气动阻力模型，同样用 box 近似。
        "aerodynamics": {
          "drag-coefficient": 0.325,
          "type": "geometry",
          "geometry": {
            "box": {
              "size": "0.180 0.110 0.040"
            }
          }
        }
      },
      // 碰撞参数：弹性和摩擦。
      "collision": {
        "restitution": 0.1,
        "friction": 0.5
      },
      // 在 UE 中显示的机体模型资源。
      "visual": {
        "geometry": {
          "type": "unreal_mesh",
          "name": "/Drone/Quadrotor1"
        }
      }
    },
    {
      // 前左桨叶/电机部件。FL = Front Left。
      "name": "Prop_FL",
      "inertial": {
        // 相对 Frame 的位置和姿态。xyz 单位 m，rpy-deg 单位度。
        // x 正方向通常是机头前方；从 FL/FR 坐标看，y 正方向对应右侧。
        "origin": {
          "xyz": "0.253 -0.253 -0.01",
          "rpy-deg": "0 0 0"
        },
        // 单个桨/电机部件质量。
        "mass": 0.055,
        // 用点质量近似转子惯性。
        "inertia": {
          "type": "point-mass"
        },
        // 桨盘气动外形，用圆柱近似。
        "aerodynamics": {
          "drag-coefficient": 0.325,
          "type": "geometry",
          "geometry": {
            "cylinder": {
              "radius": 0.1143,
              "length": 0.01
            }
          }
        }
      },
      "visual": {
        // 视觉模型相对 Frame 的位置，需要和 inertial/origin 对齐。
        "origin": {
          "xyz": "0.253 -0.253 -0.01",
          "rpy-deg": "0 0 0"
        },
        "geometry": {
          "type": "unreal_mesh",
          "name": "/Drone/PropellerRed"
        }
      }
    },
    {
      // 前右桨叶/电机部件。FR = Front Right。
      "name": "Prop_FR",
      "inertial": {
        "origin": {
          "xyz": "0.253 0.253 -0.01",
          "rpy-deg": "0 0 0"
        },
        "mass": 0.055,
        "inertia": {
          "type": "point-mass"
        },
        "aerodynamics": {
          "drag-coefficient": 0.325,
          "type": "geometry",
          "geometry": {
            "cylinder": {
              "radius": 0.1143,
              "length": 0.01
            }
          }
        }
      },
      "visual": {
        "origin": {
          "xyz": "0.253 0.253 -0.01",
          "rpy-deg": "0 0 0"
        },
        "geometry": {
          "type": "unreal_mesh",
          "name": "/Drone/PropellerRed"
        }
      }
    },
    {
      // 后左桨叶/电机部件。RL = Rear Left。
      "name": "Prop_RL",
      "inertial": {
        "origin": {
          "xyz": "-0.253 -0.253 -0.01",
          "rpy-deg": "0 0 0"
        },
        "mass": 0.055,
        "inertia": {
          "type": "point-mass"
        },
        "aerodynamics": {
          "drag-coefficient": 0.325,
          "type": "geometry",
          "geometry": {
            "cylinder": {
              "radius": 0.1143,
              "length": 0.01
            }
          }
        }
      },
      "visual": {
        "origin": {
          "xyz": "-0.253 -0.253 -0.01",
          "rpy-deg": "0 0 0"
        },
        "geometry": {
          "type": "unreal_mesh",
          "name": "/Drone/PropellerWhite"
        }
      }
    },
    {
      // 后右桨叶/电机部件。RR = Rear Right。
      "name": "Prop_RR",
      "inertial": {
        "origin": {
          "xyz": "-0.253 0.253 -0.01",
          "rpy-deg": "0 0 0"
        },
        "mass": 0.055,
        "inertia": {
          "type": "point-mass"
        },
        "aerodynamics": {
          "drag-coefficient": 0.325,
          "type": "geometry",
          "geometry": {
            "cylinder": {
              "radius": 0.1143,
              "length": 0.01
            }
          }
        }
      },
      "visual": {
        "origin": {
          "xyz": "-0.253 0.253 -0.01",
          "rpy-deg": "0 0 0"
        },
        "geometry": {
          "type": "unreal_mesh",
          "name": "/Drone/PropellerWhite"
        }
      }
    }
  ],

  // joints 定义部件之间的连接关系。这里四个桨叶都固定连接到主机体 Frame。
  "joints": [
    {
      "id": "Frame_Prop_FL",
      // fixed 表示固定连接，不是可自由运动的机械关节。
      "type": "fixed",
      "parent-link": "Frame",
      "child-link": "Prop_FL",
      "axis": "0 0 1"
    },
    {
      "id": "Frame_Prop_FR",
      "type": "fixed",
      "parent-link": "Frame",
      "child-link": "Prop_FR",
      "axis": "0 0 1"
    },
    {
      "id": "Frame_Prop_RL",
      "type": "fixed",
      "parent-link": "Frame",
      "child-link": "Prop_RL",
      "axis": "0 0 1"
    },
    {
      "id": "Frame_Prop_RR",
      "type": "fixed",
      "parent-link": "Frame",
      "child-link": "Prop_RR",
      "axis": "0 0 1"
    }
  ],

  // 飞控配置：simple-flight-api 控制四旋翼 X 架构。
  "controller": {
    "id": "Simple_Flight_Controller",
    "airframe-setup": "quadrotor-x",
    "type": "simple-flight-api",
    "simple-flight-api-settings": {
      // 飞控输出通道对应的电机顺序，顺序错了会导致起飞/姿态控制异常。
      "actuator-order": [
        {
          "id": "Prop_FR_actuator"
        },
        {
          "id": "Prop_RL_actuator"
        },
        {
          "id": "Prop_FL_actuator"
        },
        {
          "id": "Prop_RR_actuator"
        }
      ]
    }
  },

  // actuators 定义真正产生推力和反扭矩的四个旋翼执行器。
  "actuators": [
    {
      "name": "Prop_FL_actuator",
      "type": "rotor",
      "enabled": true,
      // 执行器挂在主机体 Frame 上，作用到对应的桨叶 link。
      "parent-link": "Frame",
      "child-link": "Prop_FL",
      // 电机位置相对 Frame，需和对应 Prop_FL 的 link 位置一致。
      "origin": {
        "xyz": "0.253 -0.253 -0.01",
        "rpy-deg": "0 0 0"
      },
      "rotor-settings": {
        // 旋翼旋转方向，四个电机需要按对角线交替。
        "turning-direction": "clock-wise",
        // 桨盘法向/推力方向，和仿真坐标系强相关。
        "normal-vector": "0.0 0.0 -1.0",
        // 推力系数和反扭矩系数。
        "coeff-of-thrust": 0.109919,
        "coeff-of-torque": 0.040164,
        // 最大转速 RPM。
        "max-rpm": 6396.667,
        // 桨叶直径，单位 m；0.2286m 约等于 9 英寸。
        "propeller-diameter": 0.2286,
        // 电机响应平滑时间常数。
        "smoothing-tc": 0.005
      }
    },
    {
      "name": "Prop_FR_actuator",
      "type": "rotor",
      "enabled": true,
      "parent-link": "Frame",
      "child-link": "Prop_FR",
      // 前右电机位置。
      "origin": {
        "xyz": "0.253 0.253 -0.01",
        "rpy-deg": "0 0 0"
      },
      "rotor-settings": {
        "turning-direction": "counter-clock-wise",
        "normal-vector": "0.0 0.0 -1.0",
        "coeff-of-thrust": 0.109919,
        "coeff-of-torque": 0.040164,
        "max-rpm": 6396.667,
        "propeller-diameter": 0.2286,
        "smoothing-tc": 0.005
      }
    },
    {
      "name": "Prop_RL_actuator",
      "type": "rotor",
      "enabled": true,
      "parent-link": "Frame",
      "child-link": "Prop_RL",
      // 后左电机位置。
      "origin": {
        "xyz": "-0.253 -0.253 -0.01",
        "rpy-deg": "0 0 0"
      },
      "rotor-settings": {
        "turning-direction": "counter-clock-wise",
        "normal-vector": "0.0 0.0 -1.0",
        "coeff-of-thrust": 0.109919,
        "coeff-of-torque": 0.040164,
        "max-rpm": 6396.667,
        "propeller-diameter": 0.2286,
        "smoothing-tc": 0.005
      }
    },
    {
      "name": "Prop_RR_actuator",
      "type": "rotor",
      "enabled": true,
      "parent-link": "Frame",
      "child-link": "Prop_RR",
      // 后右电机位置。
      "origin": {
        "xyz": "-0.253 0.253 -0.01",
        "rpy-deg": "0 0 0"
      },
      "rotor-settings": {
        "turning-direction": "clock-wise",
        "normal-vector": "0.0 0.0 -1.0",
        "coeff-of-thrust": 0.109919,
        "coeff-of-torque": 0.040164,
        "max-rpm": 6396.667,
        "propeller-diameter": 0.2286,
        "smoothing-tc": 0.005
      }
    }
  ],

  // sensors 定义相机、IMU、雷达、GPS、气压计、电池等传感器。
  // parent-link 为 Frame 时，origin 都是相对无人机机体中心的坐标，不是 UE 世界坐标。
  "sensors": [
    {
      // 追踪/观察相机，通常用于从无人机后方观察机体。
      "id": "Chase",
      "type": "camera",
      // 开着：它是 UE 窗口的视角相机（文档: robot config 里**第一个 streaming-enabled
      // 的相机**即该机器人的 viewpoint，见 docs/transition_from_airsim.md:69）。
      // 吃 GPU 的是下面的 capture-enabled(每帧像素 GPU→CPU 拷贝+打包)，不是 streaming
      // (GPU 内 h.264 编码)。所以 capture 关掉、streaming 留着 —— 观察和帧率兼得。
      "enabled": true,
      "parent-link": "Frame",
      // 采集间隔 0.03s，约 33 FPS。
      "capture-interval": 0.03,
      "capture-settings": [
        {
          // image-type 0 = 普通场景 RGB 图。
          "image-type": 0,
          // 960x540：与 FrontCamera 三路对齐（07-30 那次改漏了这一路）。capture 关掉只省了
          // GPU→CPU 拷贝，**渲染和 h.264 编码仍按分辨率计**，1920x1080 是 4 倍像素。
          // 宽高比仍 16:9 → vFOV 仍 58.7°，下面 origin 注释里那套视野覆盖计算不受影响。
          "width": 960,
          "height": 540,
          // 相机视场角，单位度。越大越容易看到机体边缘/桨叶。
          "fov-degrees": 90,
          // false：没有任何客户端订阅 Chase，开着等于每秒 33 帧 1920x1080 白拷回 CPU。
          // 官方就是这么建议的（docs/sensors/camera_streaming.md:31）。
          "capture-enabled": false,
          // 是否开启视频流输出。UE 窗口靠它显示，必须留 true。
          "streaming-enabled": true,
          // RGB 图通常用 uint8，所以这里是 false。
          "pixels-as-float": false,
          "compress": false,
          "target-gamma": 2.5
        }
      ],
      // 云台锁定设置：锁 roll/pitch，不锁 yaw。
      "gimbal": {
        "lock-roll": true,
        "lock-pitch": true,
        "lock-yaw": false
      },
      // 第三人称"越肩"跟随视角：机后 5m、**机左 2.5m**、机上 1.8m，下俯 33°、右转 18°。
      // 直线距离 5.9m，机体占画面宽 8%（74/960 px）。
      // gimbal 锁 roll/pitch → 俯角绝对，不随机身晃；不锁 yaw → 始终从左后方跟着。
      //
      // 三个旋钮（机体系 NED: x前 y右 z下）：
      //   xyz 整体缩放 = 远近。等比缩放时斜角与方位角都不变，只有机体大小变：
      //                  9.4m→5%  5.9m→8%(现在)  4.7m→10%  3.8m→12%  3.0m→15%
      //   xyz 第2个    = 左右偏移，**负=左**。|y|/|x| 决定斜角（2.5/5 → 26.6°）
      //   rpy 第3个    = yaw，**正=右转**把机体拉回画面。等于 atan(|y|/|x|)=26.6° 时机体居中；
      //                  取 18° 略小 → 机体偏右、前方目标偏左，即越肩构图
      //
      // ⚠️ 拉近有个反直觉的副作用：相机跟着降低，**高站位目标的俯角反而变大**、更贴下沿
      //    （9.4m 时 51.9° → 5.9m 时 54.6°）。所以 pitch 由 -30 补到 **-33**，下沿推到 62.4°。
      //    以后每次大幅拉近都要重算这条，否则高站位目标会悄悄掉出画面。
      //
      // 视野核对（hFOV 90°，vFOV = 2*atan(tan45°*540/960) = 58.7° → 俯角覆盖 3.6°~62.4°）：
      //   机体自身              方位  +8.6°  俯角 17.8° ✅ 画面右上，看得清左侧面
      //   典型   r16.6/alt19.3  方位 -11.4°  俯角 44.1° ✅ 画面左下
      //   高站位 r16.7/alt28.9  方位 -11.4°  俯角 54.6° ✅（07-31 实跑看不见的就是这条，余量 7.8°）
      //   低站位 r18.8/alt13.9  方位 -12.0°  俯角 33.3° ✅
      //   极端陡 r8 /alt30      方位  -7.1°  俯角 67.4° ❌ 掉出下沿。要救得 pitch<-38，
      //                                                   但那样机体又跑画面顶上，故放弃（此类站位占比小）
      "origin": {
        "xyz": "-5.0 -2.5 -1.8",
        "rpy-deg": "0 -33 18"
      }
    },
    {
      // 前视相机。当前文件里没有 DownCamera，下视相机需要另加或改这个相机姿态。
      "id": "FrontCamera",
      "type": "camera",
      "enabled": true,
      "parent-link": "Frame",
      // 采集间隔 0.1s，10 FPS，与 collect_episode 的 10Hz 控制对齐（事件驱动等新帧→均匀 dt）。
      "capture-interval": 0.1,
      "capture-settings": [
        {
          // image-type 0 = 普通 RGB/Scene 图。
          "image-type": 0,
          "width": 960,
          "height": 540,
          "fov-degrees": 90,
          "capture-enabled": true,
          "streaming-enabled": true,
          "pixels-as-float": false,
          "compress": false,
          "target-gamma": 2.5
        },
        {
          // image-type 2 = depth perspective，表示相机光心到物体点的射线距离。
          "image-type": 2,
          "width": 960,
          "height": 540,
          "fov-degrees": 90,
          // 建图需要深度：capture+streaming 都要开，pub/sub 才订得到（RGB 那路同理）。
          // 平时不建图想省 GPU 就改回 false。
          "capture-enabled": true,
          "streaming-enabled": true,
          "pixels-as-float": true,
          "compress": false
        },
        {
          // image-type 3 = SEGMENTATION(语义分割掩膜)。**临时开启做能力探测**。
          // 只给 evaluator 用(真值"目标是否在视野/占画面比例"), 绝不能喂控制器。
          // 与 RGB/深度统一为 960x540，便于逐像素对应并控制渲染带宽。
          // 采集训练数据时改回 capture-enabled: false。
          "image-type": 3,
          "width": 960,
          "height": 540,
          "fov-degrees": 90,
          "capture-enabled": true,
          "streaming-enabled": true,
          "pixels-as-float": false,
          "compress": false
        }
        // ↓↓↓ 深度可视化路（已验证可用，平时关闭以省一路渲染）。要看深度就整块取消注释。
        //     逗号故意在块首，注释/反注释都不会留下非法的尾随逗号。
        //     image-type 4 = DEPTH_VIS：仿真端按 max-depth-meters 归一化成 近黑→远白。
        //     与 image-type 2 是同一份深度，区别只在"谁来定量程"：
        //       2 = 物理米制（给算法）→ 值 4~518 远超颜色的 [0,1]，viewport 里必然全白
        //       4 = 归一化灰度（给人眼）
        //     ⚠️ max-depth-meters 必须显式写：C++ 默认值 1.0
        //        （core_sim/include/core_sim/sensors/camera.hpp:108），不写则 1m 外全白＝白加。
        // ,{
        //   "image-type": 4,
        //   "width": 960,
        //   "height": 540,
        //   "fov-degrees": 90,
        //   "capture-enabled": false,
        //   "streaming-enabled": true,
        //   "max-depth-meters": 60,
        //   "pixels-as-float": false,
        //   "compress": false
        // }
        // ↑↑↑ 深度可视化路到此 ↑↑↑
      ],
      // 相机相对 Frame 向机头方向偏移 0.5m。
      // airbase 场景：斜下滑近接触地面飞机，相机下倾 pitch=-50°（较陡, 对齐从高空滑向地面目标的
      // 滑降角→目标全程居中、cy 闭环温和；仍看得见前方目标、保留前进光流, 斜视动力学利于世界模型）。
      // 配合缩小飞机(~20m); 垂直方向靠伺服 cy 闭环(视线角控制)沿视线接触，不再开环匀速降。
      "origin": {
        "xyz": "0.5 0.0 0.0",
        "rpy-deg": "0 -50 0"
      }
    },
    {
      // 惯性测量单元：加速度计 + 陀螺仪。
      "id": "IMU1",
      "type": "imu",
      "enabled": true,
      "parent-link": "Frame",
      // 加速度计噪声/偏置模型。
      "accelerometer": {
        "velocity-random-walk": 2.3e-3,
        "tau": 800,
        "bias-stability": 3.53e-4,
        "turn-on-bias": "0 0 0"
      },
      // 陀螺仪噪声/偏置模型。
      "gyroscope": {
        "angle-random-walk": 1.027e-4,
        "tau": 500,
        "bias-stability": 2.23e-5,
        "turn-on-bias": "0 0 0"
      }
    },
    {
      // 16 线激光雷达。
      "id": "lidar1",
      "type": "lidar",
      // 关闭：16 线激光每秒 10 万点的射线计算耗 CPU/GPU，世界模型用不到。需要时改回 true。
      "enabled": false,
      "parent-link": "Frame",
      "number-of-channels": 16,
      // 最大测距，单位 m。
      "range": 100,
      // 每秒点数。
      "points-per-second": 100000,
      // 水平旋转频率，单位 Hz。
      "horizontal-rotation-frequency": 10,
      // 水平视场角 0-360 度。
      "horizontal-fov-start-deg": 0.0,
      "horizontal-fov-end-deg": 360.0,
      // 垂直视场角，从水平到向下 90 度。
      "vertical-fov-upper-deg": 0.0,
      "vertical-fov-lower-deg": -90.0,
      "draw-debug-points": false,
      // 雷达相对 Frame 的安装位置。
      "origin": {
        "xyz": "0 0 0.2",
        "rpy-deg": "0 0 0"
      }
    },
    {
      // 单点测距传感器，例如朝下测高。
      "id": "DistanceSensor",
      "type": "distance-sensor",
      "enabled": true,
      "parent-link": "Frame",
      // 最大/最小有效测距，单位 m。
      "max-distance": 50.0,
      "min-distance": 0.5,
      "draw-debug-points": true,
      // rpy-deg: "0 -90 0" 通常用于让传感器朝下。
      "origin": {
        "xyz": "0 0 0.2",
        "rpy-deg": "0 -90 0"
      }
    },
    {
      // GPS 传感器，下面是水平/垂直定位误差收敛参数。
      "id": "GPS",
      "type": "gps",
      "enabled": true,
      "parent-link": "Frame",
      "eph-time-constant": 0.9,
      "epv-time-constant": 0.9,
      "eph-initial": 100,
      "epv-initial": 100,
      "eph-final": 0.1,
      "epv-final": 0.1,
      "eph-min_3d": 3.0,
      "eph-min_2d": 4.0
    },
    {
      // 气压计，用于高度估计。
      "id": "Barometer",
      "type": "barometer",
      "enabled": true,
      "parent-link": "Frame",
      // 标准海平面气压，单位 hPa。
      "qnh": 1013.250,
      "pressure-factor-sigma": 0.001825,
      "pressure-factor-tau": 3600,
      "uncorrelated-noise-sigma": 2.7,
      "update-latency": 0,
      "update-frequency": 50,
      "startup-delay": 0
    },
    {
      // 磁力计，用于航向估计。
      "id": "Magnetometer",
      "type": "magnetometer",
      "enabled": true,
      "parent-link": "Frame",
      "scale-factor": 1,
      "noise-sigma": "0.005 0.005 0.005", // 5 mgauss as per LSM303D spec-sheet
      "noise-bias": "0.0 0.0 0.0" // no offset as per specsheet (zero gauss level)
    },
    {
      // 空速计。forward-xyz 指定机头/前向方向。
      "id": "Airspeed",
      "type": "airspeed",
      "enabled": true,
      "parent-link": "Frame",
      "pressure-factor-sigma": 0.001825,
      "pressure-factor-tau": 3600,
      "uncorrelated-noise-sigma": 1.052,
      "forward-xyz": "1.0 0.0 0.0"
    },
    {
      // 电池模型。
      "id": "Battery",
      "type": "battery",
      "enabled": true,
      "parent-link": "Frame",

      // Total battery capacity.
      // Typically, on start capacity should be lower than total battery capacity.
      // Use joules as unit for capacity.
      // 1 joule = 3600 * Amp hour
      // 1 joule = 3.6 * milli Amp hour
      "total-battery-capacity": 36000,
      "battery-capacity-on-start": 30000,

      // Battery has two simulated mode: Rotor power discharge or simple discharge model

      // Rotor power discharge mode depletes power proportional to torque*angular_velocity
      //  Simple discharge mode, depletes at rate specified.

      // Config for rotor power discharge mode.
      // You can configure the constant of proportionality using config option.
      "battery-mode": "rotor-power-discharge-mode",
      "rotor-power-coefficient": 1

      // Config for simple discharge model. The drain rate can be adjusted at runtime using client api calls.
      // "battery-mode":"simple-discharge-mode",
      // "battery-drain-rate-on-start": 1
    }
  ]
}
