Panels:
- Class: rviz_common/Displays
  Name: Displays
- Class: rviz_common/Views
  Name: Views
Visualization Manager:
  Class: ''
  Displays:
  - Class: rviz_default_plugins/PointCloud2
    Name: Recorded RGB-D map
    Enabled: true
    Value: true
    Alpha: 1
    Style: Points
    Size (Pixels): 3
    Size (m): 0.2
    Color Transformer: RGB8
    Position Transformer: XYZ
    Topic:
      Value: /opening/map
      Depth: 1
      Durability Policy: Transient Local
      Reliability Policy: Reliable
      History Policy: Keep Last
  - Class: rviz_default_plugins/MarkerArray
    Name: Capture poses and projected aperture
    Enabled: true
    Value: true
    Namespaces: {}
    Topic:
      Value: /opening/markers
      Depth: 5
      Durability Policy: Volatile
      Reliability Policy: Reliable
      History Policy: Keep Last
  - Class: rviz_default_plugins/Path
    Name: Recorded flight trajectory
    Enabled: true
    Value: true
    Line Style: Lines
    Line Width: 0.2
    Color: 0; 200; 255
    Pose Style: None
    Topic:
      Value: /opening/path
      Depth: 1
      Durability Policy: Transient Local
      Reliability Policy: Reliable
      History Policy: Keep Last
  - Class: rviz_default_plugins/Image
    Name: Recorded image or offline diagnostic
    Enabled: true
    Value: true
    Normalize Range: true
    Topic:
      Value: /opening/view
      Depth: 2
      Durability Policy: Volatile
      Reliability Policy: Reliable
      History Policy: Keep Last
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 150
      Focal Point: {X: 713.4, Y: -28.3, Z: 25.0}
      Name: Current View
      Pitch: 0.75
      Yaw: 4.4
      Target Frame: <Fixed Frame>
    Saved:
    - Class: rviz_default_plugins/Orbit
      Name: Hangar interior
      Distance: 45
      Focal Point: {X: 717.4, Y: -30.5, Z: 14.7}
      Pitch: 0.25
      Yaw: 4.4
      Target Frame: <Fixed Frame>
Window Geometry:
  Height: 900
  Width: 1500
  Hidden: false
